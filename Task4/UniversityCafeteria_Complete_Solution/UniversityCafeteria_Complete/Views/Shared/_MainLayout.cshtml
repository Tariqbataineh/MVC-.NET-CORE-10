<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | University Cafeteria</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>@await RenderSectionAsync("Styles", required: false)</head>
<body><header class="topbar"><div class="container d-flex align-items-center justify-content-between flex-wrap gap-2"><a class="brand" href="@Url.Action("Index", "SupplyRequest")">UNIVERSITY <strong>CAFETERIA</strong></a><span class="subtitle">Supply Management Portal</span></div></header>
<nav class="navwrap"><div class="container d-flex flex-wrap gap-2 py-3">
<a class="navpill" href="@Url.Action("Index", "Cafeteria")">Home</a>
<a class="navpill" href="@Url.Action("Products", "Cafeteria")">Products</a>
<a class="navpill" href="@Url.Action("Suppliers", "Cafeteria")">Suppliers</a>
<a class="navpill" href="@Url.Action("Index", "Supply")">Categories</a>
<a class="navpill" href="@Url.Action("CreateRequest", "Supply")">Legacy Request</a>
<a class="navpill active" href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>
<a class="navpill" href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>
<a class="navpill" href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>
<a class="navpill" href="@Url.Action("About", "SupplyRequest")">About</a>
</div></nav>
<main class="container page"><div class="page-heading"><div class="eyebrow">CAFETERIA OPERATIONS</div><h1>@ViewData["Title"]</h1></div>
@if (TempData["Message"] is string msg) { <div class="alert alert-success" role="status">@msg</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@RenderBody()</main><footer class="footer"><div class="container">University Cafeteria · Supply Management System</div></footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
