@{ Layout = "_SimpleLayout"; ViewData["Title"] = "Suppliers"; string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company" }; }
<section class="panel"><ul>@foreach (var supplier in suppliers) { <li>@supplier</li> }</ul>@if (suppliers.Length >= 3) { <p>We have enough suppliers.</p> } else { <p>We need more suppliers.</p> }</section>
