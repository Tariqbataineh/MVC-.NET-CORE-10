@{ Layout = null; string[] products = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" }; string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company", "Fresh Food Company", "Daily Supplies Company" }; int[] quantities = { 100, 20, 50, 0, 30 }; string[] statuses = { "Available", "Low Stock", "Available", "Out of Stock", "Available" }; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Supply Status</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/></head><body class="container py-5"><h1>Supply Status</h1><table class="table table-bordered table-striped table-hover"><thead><tr><th>Number</th><th>Product Name</th><th>Supplier</th><th>Quantity</th><th>Status</th></tr></thead><tbody>@for (int i = 0; i < products.Length; i++) { string badge = statuses[i] == "Available" ? "bg-success" : statuses[i] == "Low Stock" ? "bg-warning text-dark" : "bg-danger"; <tr><td>@(i + 1)</td><td>@products[i]</td><td>@suppliers[i]</td><td>@quantities[i]</td><td><span class="badge @badge">@statuses[i]</span></td></tr> }</tbody></table><a href="/Cafeteria/Index">Back to Home</a></body></html>
