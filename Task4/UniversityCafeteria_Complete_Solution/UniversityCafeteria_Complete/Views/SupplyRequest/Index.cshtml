@model RequestPageModel
@{ ViewData["Title"] = "Create Supply Request"; }
<div class="row g-4"><div class="col-lg-8"><section class="panel"><div class="panel-head"><h2>Add a product</h2><p>Add multiple items before reviewing the request.</p></div>
<form asp-controller="SupplyRequest" asp-action="AddItem" method="post" class="row g-3">
<div class="col-md-6"><label class="form-label" for="productName">Product Name</label><input id="productName" name="productName" class="form-control" maxlength="100" required placeholder="e.g. Coffee"/></div>
<div class="col-md-6"><label class="form-label" for="category">Category</label><select id="category" name="category" class="form-select"><option>Drinks</option><option>Food</option><option>Snacks</option><option>Hot Drinks</option><option>Cold Drinks</option><option>Other</option></select></div>
<div class="col-md-4"><label class="form-label" for="quantity">Quantity</label><input type="number" id="quantity" name="quantity" min="1" step="1" value="1" required class="form-control"/></div>
<div class="col-md-4"><label class="form-label" for="unitPrice">Unit Price (JD)</label><input type="number" id="unitPrice" name="unitPrice" min="0.01" step="0.01" required class="form-control" placeholder="0.00"/></div>
<div class="col-md-4"><label class="form-label" for="priority">Priority</label><select id="priority" name="priority" class="form-select">@foreach (var choice in new[] { "Normal", "Urgent", "Emergency" }) { if (Model.PreferredPriority == choice) { <option value="@choice" selected>@choice</option> } else { <option value="@choice">@choice</option> } }</select></div>
<div class="col-12"><button class="btn btn-primary" type="submit">Add to Draft</button><a class="btn btn-outline-secondary ms-2" href="@Url.Action("Review", "SupplyRequest")">Review Draft</a></div>
</form></section></div><div class="col-lg-4"><section class="panel h-100"><div class="panel-head"><h2>Current draft</h2><p>Items stay in your session until confirmation or removal.</p></div><div class="metric">@Model.Summary.Items.Count <span>items</span></div><div class="d-flex justify-content-between mb-2"><span>Subtotal</span><strong>@Model.Summary.Subtotal.ToString("0.00") JD</strong></div><div class="d-flex justify-content-between mb-2"><span>Priority</span><strong>@Model.Summary.Priority</strong></div><div class="d-flex justify-content-between"><span>Final total</span><strong>@Model.Summary.FinalTotal.ToString("0.00") JD</strong></div></section></div></div>
<section class="panel mt-4"><div class="panel-head"><h2>Default request priority</h2><p>Save your preference in a browser cookie for 7 days.</p></div><form asp-controller="SupplyRequest" asp-action="SavePreference" method="post" class="d-flex gap-2 flex-wrap align-items-end"><div><label for="preferred" class="form-label">Preferred priority</label><select id="preferred" name="priority" class="form-select">@foreach (var choice in new[] { "Normal", "Urgent", "Emergency" }) { if (Model.PreferredPriority == choice) { <option selected value="@choice">@choice</option> } else { <option value="@choice">@choice</option> } }</select></div><button class="btn btn-outline-primary" type="submit">Save Preference</button></form><div class="small text-muted mt-2">Your preferred request priority is @Model.PreferredPriority.</div></section>
