@model RequestSummary
@{ ViewData["Title"] = "Review Draft"; }
<section class="panel"><div class="panel-head"><h2>Draft products</h2><p>Check all items and costs before confirming.</p></div>
@if (!Model.Items.Any()) { <div class="empty">No products in your draft. <a href="@Url.Action("Index", "SupplyRequest")">Add your first product</a>.</div> }
else { <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>#</th><th>Product</th><th>Category</th><th>Qty</th><th>Unit price</th><th>Priority</th><th>Line total</th></tr></thead><tbody>@for (int i = 0; i < Model.Items.Count; i++) { var item = Model.Items[i]; <tr><td>@(i + 1)</td><td>@item.ProductName</td><td>@item.Category</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("0.00") JD</td><td>@item.Priority</td><td>@item.LineTotal.ToString("0.00") JD</td></tr> }</tbody></table></div>
<div class="totals"><div><span>Subtotal</span><strong>@Model.Subtotal.ToString("0.00") JD</strong></div><div><span>Preparation fee (@Model.Priority)</span><strong>@Model.PreparationFee.ToString("0.00") JD</strong></div><div><span>Discount (@((Model.DiscountRate * 100).ToString("0"))%)</span><strong>−@Model.Discount.ToString("0.00") JD</strong></div><div class="grand"><span>Final total</span><strong>@Model.FinalTotal.ToString("0.00") JD</strong></div></div> }
<div class="d-flex gap-2 flex-wrap mt-4"><a href="@Url.Action("Index", "SupplyRequest")" class="btn btn-outline-primary">Add More Products</a><form asp-action="ConfirmRequest" method="post"><button class="btn btn-primary" disabled="@(!Model.Items.Any())" type="submit">Confirm Request</button></form><form asp-action="ClearDraft" method="post"><button class="btn btn-outline-danger" disabled="@(!Model.Items.Any())" type="submit">Clear Draft</button></form></div></section>
