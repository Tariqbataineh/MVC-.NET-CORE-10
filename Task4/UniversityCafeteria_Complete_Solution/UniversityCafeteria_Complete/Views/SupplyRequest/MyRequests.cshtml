@model List<ConfirmedRequest>
@{ ViewData["Title"] = "My Requests"; }
<section class="panel"><div class="panel-head"><h2>Confirmed supply requests</h2><p>Completed orders are saved in the application's in-memory list.</p></div>
@if (Model.Count == 0) { <div class="empty">No confirmed requests yet. <a href="@Url.Action("Index", "SupplyRequest")">Create one now</a>.</div> }
else { <div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Request ID</th><th>Products</th><th>Subtotal</th><th>Preparation Fee</th><th>Discount</th><th>Final Total</th><th>Status</th></tr></thead><tbody>@foreach (var request in Model) { <tr><td>#@request.RequestId</td><td>@request.ProductCount</td><td>@request.Subtotal.ToString("0.00") JD</td><td>@request.PreparationFee.ToString("0.00") JD</td><td>@request.Discount.ToString("0.00") JD</td><td><strong>@request.FinalTotal.ToString("0.00") JD</strong></td><td><span class="badge bg-success">@request.Status</span></td></tr> }</tbody></table></div> }
<p class="small text-muted mt-3">Learning-project note: Confirmed requests are shared in server memory and reset if the app restarts. A production system would use a database and user authentication.</p></section>
