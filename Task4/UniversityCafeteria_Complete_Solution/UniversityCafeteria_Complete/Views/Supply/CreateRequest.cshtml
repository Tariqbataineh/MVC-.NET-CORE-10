@{ ViewData["Title"] = "Legacy Supply Request"; }<section class="panel"><h2>Create Request</h2><p class="text-muted">Form from the earlier MVC task.</p><form asp-controller="Supply" asp-action="SubmitRequest" method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Employee Name</label><input name="EmployeeName" class="form-control"/></div><div class="col-md-6"><label class="form-label">Product Name</label><select name="ProductName" class="form-select">@foreach (var name in new[] { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" }) { <option>@name</option> }</select></div><div class="col-md-6"><label class="form-label">Quantity</label><input name="Quantity" type="number" min="1" required class="form-control"/></div><div class="col-md-6"><label class="form-label">Required Date</label><input name="RequiredDate" type="date" required class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Submit Request</button></div></form></section>
