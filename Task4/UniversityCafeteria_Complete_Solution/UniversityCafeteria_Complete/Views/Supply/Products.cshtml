@{ ViewData["Title"] = "Cafeteria Products"; var products = (string[])ViewData["Products"]!; }<section class="panel"><h2>@ViewData["PageTitle"]</h2><p>Manager: @ViewData["ManagerName"] · Products: @ViewData["ProductCount"]</p><div class="row g-3">@foreach (var product in products) { <div class="col-sm-6 col-lg-4"><div class="card h-100"><div class="card-body">@product</div></div></div> }</div></section>
