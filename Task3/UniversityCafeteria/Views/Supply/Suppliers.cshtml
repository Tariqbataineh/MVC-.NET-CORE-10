@{
    string[] suppliers =
        ViewBag.Suppliers ?? Array.Empty<string>();

    int supplierNumber = 1;
}

<div class="page-header">

    <div>
        <h1>@ViewBag.PageTitle</h1>

        <p>
            View the cafeteria supplier directory.
        </p>
    </div>

    <span class="section-badge">
        Supplier Directory
    </span>

</div>


<!-- SUPPLIER COUNT -->

<div class="row g-4 mb-4">

    <div class="col-lg-4 col-md-6">

        <div class="info-card">

            <div class="info-icon green">
                <i class="bi bi-buildings"></i>
            </div>

            <div>
                <span class="info-label">
                    Total Suppliers
                </span>

                <h2>@ViewBag.SupplierCount</h2>
            </div>

        </div>

    </div>

</div>


<!-- SUPPLIER DIRECTORY -->

<div class="section-header">

    <div>
        <h2>Supplier Directory</h2>

        <p>
            Companies supplying products to the cafeteria.
        </p>
    </div>

</div>

<div class="row g-4">

    @foreach (string supplier in suppliers)
    {
        <div class="col-lg-4 col-md-6">

            <div class="supplier-card">

                <div class="supplier-avatar">
                    <i class="bi bi-building"></i>
                </div>

                <span class="supplier-number">
                    SUPPLIER @supplierNumber.ToString("D2")
                </span>

                <h3>@supplier</h3>

                <p>
                    Cafeteria Supplier
                </p>

                <div class="supplier-footer">

                    <span>Supplier Directory</span>

                    <i class="bi bi-check-circle"></i>

                </div>

            </div>

        </div>

        supplierNumber++;
    }

</div>