@{
    string[] products =
        ViewData["Products"] as string[] ?? Array.Empty<string>();
}

<div class="page-header">

    <div>
        <h1>@ViewData["PageTitle"]</h1>

        <p>
            View the products available in the cafeteria catalog.
        </p>
    </div>

    <span class="section-badge">
        Product Catalog
    </span>

</div>


<!-- INFORMATION CARDS -->

<div class="row g-4 mb-4">

    <div class="col-md-6">

        <div class="info-card">

            <div class="info-icon green">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <span class="info-label">Cafeteria Manager</span>

                <h2>@ViewData["ManagerName"]</h2>
            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="info-card">

            <div class="info-icon blue">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <span class="info-label">Total Products</span>

                <h2>@ViewData["ProductCount"]</h2>
            </div>

        </div>

    </div>

</div>


<!-- PRODUCT LIST -->

<div class="content-card">

    <div class="content-card-header">

        <div>
            <h2>Products</h2>

            <p>Products currently listed in the cafeteria.</p>
        </div>

        <span class="section-badge">
            @products.Length Items
        </span>

    </div>

    <div class="product-list">

        @foreach (string product in products)
        {
            <div class="product-row">

                <div class="product-row-icon">
                    <i class="bi bi-box"></i>
                </div>

                <div class="product-row-name">
                    @product
                </div>

                <span class="item-badge">
                    Listed
                </span>

            </div>
        }

    </div>

</div>