<div class="page-header">

    <div>
        <h1>About the System</h1>

        <p>
            Orange University Cafeteria Supply Management.
        </p>
    </div>

</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["Message"] is string message)
{
    <div class="success-message">

        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div>
            <strong>Request Submitted Successfully</strong>

            <p>@message</p>
        </div>

    </div>
}


<!-- ABOUT SECTION -->

<div class="content-card about-card">

    <div class="about-icon">
        <i class="bi bi-mortarboard"></i>
    </div>

    <h2>Orange University Cafeteria</h2>

    <p>
        The Cafeteria Supply Management System provides
        a centralized platform for organizing cafeteria
        products, viewing supplier information, and
        submitting supply requests.
    </p>

</div>


<!-- SYSTEM SECTIONS -->

<div class="section-header">

    <div>
        <h2>System Features</h2>

        <p>
            Core services available through the platform.
        </p>
    </div>

</div>

<div class="row g-4">

    <div class="col-lg-4 col-md-6">

        <div class="feature-card">

            <div class="feature-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h3>Product Management</h3>

            <p>
                Browse and review the products
                listed in the cafeteria catalog.
            </p>

        </div>

    </div>

    <div class="col-lg-4 col-md-6">

        <div class="feature-card">

            <div class="feature-icon">
                <i class="bi bi-buildings"></i>
            </div>

            <h3>Supplier Directory</h3>

            <p>
                Access information about the companies
                supplying cafeteria products.
            </p>

        </div>

    </div>

    <div class="col-lg-4 col-md-6">

        <div class="feature-card">

            <div class="feature-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <h3>Supply Requests</h3>

            <p>
                Submit product supply requests
                through a structured request form.
            </p>

        </div>

    </div>

</div>