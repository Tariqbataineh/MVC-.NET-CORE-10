<div class="page-header">

    <div>
        <h1>Create Supply Request</h1>

        <p>
            Complete the form to submit a new cafeteria supply request.
        </p>
    </div>

</div>


<div class="row g-4">

    <!-- REQUEST FORM -->

    <div class="col-lg-8">

        <div class="content-card">

            <div class="content-card-header">

                <div>
                    <h2>Request Details</h2>

                    <p>
                        Enter the required supply information.
                    </p>
                </div>

                <div class="form-header-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

            </div>

            <form asp-controller="Supply"
                  asp-action="SubmitRequest"
                  method="post"
                  class="request-form">

                @Html.AntiForgeryToken()

                <!-- EMPLOYEE NAME -->

                <div class="form-group">

                    <label for="EmployeeName">
                        Employee Name
                        <span class="required-mark">*</span>
                    </label>

                    <input type="text"
                           id="EmployeeName"
                           name="EmployeeName"
                           class="form-control"
                           placeholder="Enter employee name" />

                </div>


                <!-- PRODUCT NAME -->

                <div class="form-group">

                    <label for="ProductName">
                        Product Name
                        <span class="required-mark">*</span>
                    </label>

                    <select id="ProductName"
                            name="ProductName"
                            class="form-select"
                            required>

                        <option value="">
                            Select a product
                        </option>

                        <option value="Water">Water</option>

                        <option value="Orange Juice">
                            Orange Juice
                        </option>

                        <option value="Coffee">Coffee</option>

                        <option value="Sandwich">Sandwich</option>

                        <option value="Chocolate">Chocolate</option>

                    </select>

                </div>


                <!-- QUANTITY AND DATE -->

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="form-group">

                            <label for="Quantity">
                                Quantity
                                <span class="required-mark">*</span>
                            </label>

                            <input type="number"
                                   id="Quantity"
                                   name="Quantity"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   placeholder="Enter quantity"
                                   required />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="form-group">

                            <label for="RequiredDate">
                                Required Date
                                <span class="required-mark">*</span>
                            </label>

                            <input type="date"
                                   id="RequiredDate"
                                   name="RequiredDate"
                                   class="form-control"
                                   required />

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="form-actions">

                    <a asp-action="Index"
                       class="secondary-btn">

                        Cancel

                    </a>

                    <button type="submit"
                            class="primary-btn">

                        <i class="bi bi-send"></i>

                        Submit Request

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- INFORMATION PANEL -->

    <div class="col-lg-4">

        <div class="request-info-card">

            <div class="request-info-icon">
                <i class="bi bi-clipboard-check"></i>
            </div>

            <h3>Request Information</h3>

            <p>
                Please review the information before
                submitting your supply request.
            </p>

            <div class="request-info-divider"></div>

            <div class="request-info-item">

                <i class="bi bi-check-circle"></i>

                <span>Enter the employee name</span>

            </div>

            <div class="request-info-item">

                <i class="bi bi-check-circle"></i>

                <span>Select a product</span>

            </div>

            <div class="request-info-item">

                <i class="bi bi-check-circle"></i>

                <span>Specify the required quantity</span>

            </div>

            <div class="request-info-item">

                <i class="bi bi-check-circle"></i>

                <span>Choose the required date</span>

            </div>

        </div>

    </div>

</div>