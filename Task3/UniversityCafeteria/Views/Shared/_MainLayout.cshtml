@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string active(string name) => action == name ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b32" />
    <title>@(ViewData["Title"] ?? "Supply Management") · Orange University</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" aria-label="Main navigation">
            <a class="brand" asp-controller="Supply" asp-action="Index">
                <span class="brand-mark"><span>O</span></span>
                <span class="brand-copy"><strong>orange<span class="brand-dot">.</span>uni</strong><small>CAFETERIA OPERATIONS</small></span>
            </a>
            <div class="workspace-pill"><span class="workspace-indicator"></span><span>University Workspace</span><span class="workspace-arrow">⌄</span></div>
            <div class="navigation-caption">WORKSPACE</div>
            <nav class="side-links">
                <a asp-controller="Supply" asp-action="Index" class="side-link @active("Index")"><span class="nav-symbol">▦</span><span>Home</span></a>
                <a asp-controller="Supply" asp-action="Products" class="side-link @active("Products")"><span class="nav-symbol">◈</span><span>Products</span></a>
                <a asp-controller="Supply" asp-action="Suppliers" class="side-link @active("Suppliers")"><span class="nav-symbol">♧</span><span>Suppliers</span></a>
                <a asp-controller="Supply" asp-action="CreateRequest" class="side-link @active("CreateRequest")"><span class="nav-symbol">✚</span><span>Create Request</span></a>
                <a asp-controller="Supply" asp-action="About" class="side-link @active("About")"><span class="nav-symbol">ⓘ</span><span>About</span></a>
            </nav>
            <div class="sidebar-spacer"></div>
            <div class="support-card"><span class="support-star">✳</span><strong>Supply Center</strong><p>Your cafeteria workflow, simplified.</p><a asp-controller="Supply" asp-action="CreateRequest">New request <span>↗</span></a></div>
            <div class="sidebar-footer"><span class="live-indicator"></span> All systems operational <small>ASP.NET Core MVC · Day 3</small></div>
        </aside>
        <div class="main-column">
            <header class="topbar">
                <div class="topbar-location"><span class="breadcrumb-muted">Workspace</span><span class="slash">/</span><strong>@(ViewData["NavTitle"] ?? "Overview")</strong></div>
                <div class="topbar-actions"><span class="topbar-label">SUPPLY MANAGEMENT</span><span class="profile-avatar">AA</span><div class="profile-info"><strong>Ahmad Ali</strong><small>Manager</small></div></div>
            </header>
            <main class="main-content">@RenderBody()</main>
            <footer class="footer"><span>© 2026 Orange University · Cafeteria Supply Management</span><span class="footer-right">Designed for better operations <span>✦</span></span></footer>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
