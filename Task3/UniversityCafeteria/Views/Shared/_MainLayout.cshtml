@{
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    string Active(string page)
    {
        return action == page ? "active" : "";
    }

    string pageName = action switch
    {
        "Index" => "Dashboard",
        "Products" => "Products",
        "Suppliers" => "Suppliers",
        "CreateRequest" => "Create Request",
        "SubmitRequest" => "Request Status",
        "About" => "About",
        _ => "Supply Management"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageName | Orange University</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <a asp-controller="Supply"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="brand-text">
                    <strong>Orange University</strong>
                    <span>Cafeteria Management</span>
                </div>

            </a>

            <div class="navigation-title">
                MAIN MENU
            </div>

            <nav class="sidebar-menu">

                <a asp-controller="Supply"
                   asp-action="Index"
                   class="menu-link @Active("Index")">

                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>

                </a>

                <a asp-controller="Supply"
                   asp-action="Products"
                   class="menu-link @Active("Products")">

                    <i class="bi bi-box-seam"></i>
                    <span>Products</span>

                </a>

                <a asp-controller="Supply"
                   asp-action="Suppliers"
                   class="menu-link @Active("Suppliers")">

                    <i class="bi bi-buildings"></i>
                    <span>Suppliers</span>

                </a>

                <a asp-controller="Supply"
                   asp-action="CreateRequest"
                   class="menu-link @Active("CreateRequest")">

                    <i class="bi bi-file-earmark-plus"></i>
                    <span>Create Request</span>

                </a>

                <a asp-controller="Supply"
                   asp-action="About"
                   class="menu-link @Active("About")">

                    <i class="bi bi-info-circle"></i>
                    <span>About</span>

                </a>

            </nav>

            <div class="sidebar-bottom">

                <div class="sidebar-info">
                    <i class="bi bi-shield-check"></i>

                    <div>
                        <strong>Supply Management</strong>
                        <span>University Cafeteria</span>
                    </div>
                </div>

            </div>

        </aside>


        <!-- MAIN AREA -->
        <div class="main-area">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">

                    <span>Management</span>

                    <i class="bi bi-chevron-right"></i>

                    <strong>@pageName</strong>

                </div>

                <div class="topbar-right">

                    <div class="user-avatar">AA</div>

                    <div class="user-details">
                        <strong>Ahmad Ali</strong>
                        <span>Cafeteria Manager</span>
                    </div>

                </div>

            </header>


            <!-- VIEW CONTENT -->
            <main class="main-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="app-footer">

                <span>
                    © 2026 Orange University
                </span>

                <span>
                    Cafeteria Supply Management System
                </span>

            </footer>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>