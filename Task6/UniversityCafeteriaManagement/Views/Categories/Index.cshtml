@model List<UniversityCafeteriaManagement.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">

    <h2>Categories</h2>

    <a href="@Url.Action("Create", "Categories")" class="btn btn-primary mb-3">
        Add Category
    </a>

    <table class="table table-bordered">

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
        </tr>

        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
            </tr>
        }

    </table>

</div>