@model IEnumerable<Order>

<h2>Orders</h2>

<a href="/Order/Create">Add Order</a>

<br />
<br />

<table border="1">
    <tr>
        <th>ID</th>
        <th>Customer Name</th>
        <th>Order Date</th>
        <th>Total Price</th>
        <th>Status</th>
        <th>Employee</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.CustomerName</td>
            <td>@item.OrderDate.ToShortDateString()</td>
            <td>@item.TotalPrice</td>
            <td>@item.Status</td>
            <td>@item.Employee?.FullName</td>
            <td>
                <a href="/Order/Edit/@item.Id">Edit</a>
                <a href="/Order/Details/@item.Id">Details</a>

                <form action="/Order/Delete/@item.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure?');">

                    @Html.AntiForgeryToken()

                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>