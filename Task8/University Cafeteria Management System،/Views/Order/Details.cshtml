@model Order

<h2>Order Details</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <th>Customer Name</th>
        <td>@Model.CustomerName</td>
    </tr>
    <tr>
        <th>Order Date</th>
        <td>@Model.OrderDate.ToShortDateString()</td>
    </tr>
    <tr>
        <th>Total Price</th>
        <td>@Model.TotalPrice</td>
    </tr>
    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>
    <tr>
        <th>Employee</th>
        <td>@Model.Employee?.FullName</td>
    </tr>
</table>

<br />

<a href="/Order/Index">Back</a>