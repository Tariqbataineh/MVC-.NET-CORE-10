@model Order

<h2>Edit Order</h2>

<form action="/Order/Edit" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Customer Name</label>
    <input type="text" name="CustomerName"
           value="@Model.CustomerName" />

    <br /><br />

    <label>Order Date</label>
    <input type="date" name="OrderDate"
           value="@Model.OrderDate.ToString("yyyy-MM-dd")" />

    <br /><br />

    <label>Total Price</label>
    <input type="number" step="0.01" name="TotalPrice"
           value="@Model.TotalPrice" />

    <br /><br />

    <label>Status</label>
    <input type="text" name="Status" value="@Model.Status" />

    <br /><br />

    <label>Employee</label>
    <select name="EmployeeId">
        @foreach (Employee employee in ViewBag.Employees)
        {
            if (employee.Id == Model.EmployeeId)
            {
                <option value="@employee.Id" selected>@employee.FullName</option>
            }
            else
            {
                <option value="@employee.Id">@employee.FullName</option>
            }
        }
    </select>

    <br /><br />

    <button type="submit">Save Changes</button>
</form>

<br />

<a href="/Order/Index">Back</a>