@model Supplier

<h2>Edit Supplier</h2>

<form action="/Supplier/Edit" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Name</label>
    <input type="text" name="Name" value="@Model.Name" />

    <br /><br />

    <label>Phone</label>
    <input type="text" name="Phone" value="@Model.Phone" />

    <br /><br />

    <label>Email</label>
    <input type="email" name="Email" value="@Model.Email" />

    <br /><br />

    <label>Address</label>
    <input type="text" name="Address" value="@Model.Address" />

    <br /><br />

    <button type="submit">Save Changes</button>
</form>

<br />

<a href="/Supplier/Index">Back</a>