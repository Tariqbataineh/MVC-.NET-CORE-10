@model IEnumerable<Supplier>

<h2>Suppliers</h2>

<a href="/Supplier/Create">Add Supplier</a>

<br />
<br />

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Address</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.Address</td>
            <td>
                <a href="/Supplier/Edit/@item.Id">Edit</a>

                <a href="/Supplier/Details/@item.Id">Details</a>

                <form action="/Supplier/Delete/@item.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure?');">

                    @Html.AntiForgeryToken()

                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>