@model Product

<h2>Product Details</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>
    <tr>
        <th>Price</th>
        <td>@Model.Price</td>
    </tr>
    <tr>
        <th>Quantity</th>
        <td>@Model.Quantity</td>
    </tr>
    <tr>
        <th>Category</th>
        <td>@Model.Category?.Name</td>
    </tr>
    <tr>
        <th>Supplier</th>
        <td>@Model.Supplier?.Name</td>
    </tr>
</table>

<br />

<a href="/Product/Index">Back</a>