@model IEnumerable<Employee>

<h2>Employees</h2>

<a href="/Employee/Create">Add Employee</a>

<br />
<br />

<table border="1">
    <tr>
        <th>ID</th>
        <th>Full Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Position</th>
        <th>Salary</th>
        <th>Hire Date</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FullName</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.Position</td>
            <td>@item.Salary</td>
            <td>@item.HireDate.ToShortDateString()</td>
            <td>
                <a href="/Employee/Edit/@item.Id">Edit</a>
                <a href="/Employee/Details/@item.Id">Details</a>

                <form action="/Employee/Delete/@item.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure?');">

                    @Html.AntiForgeryToken()

                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>