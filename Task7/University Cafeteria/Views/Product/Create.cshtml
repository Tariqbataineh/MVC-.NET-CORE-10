@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Add Product</h2>

<p style="color:red">@ViewBag.Error</p>

@using (Html.BeginForm("Create", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <label>Name</label>
    @Html.TextBox("Name")

    <br />
    <br />

    <label>Price</label>
    @Html.TextBox("Price", null, new { type = "number", step = "0.01", min = "0" })

    <br />
    <br />

    <label>Quantity</label>
    @Html.TextBox("Quantity", null, new { type = "number", min = "0" })

    <br />
    <br />

    <label>Category</label>
    @Html.DropDownList(
        "CategoryId",
        new SelectList(ViewBag.Categories, "Id", "Name"),
        "Select Category"
    )

    <br />
    <br />

    <label>Supplier</label>
    @Html.DropDownList(
        "SupplierId",
        new SelectList(ViewBag.Suppliers, "Id", "Name"),
        "Select Supplier"
    )

    <br />
    <br />

    <button type="submit">Save</button>
}

<br />

@Html.ActionLink("Back", "Index", "Product")